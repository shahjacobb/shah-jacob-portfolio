---
import DarkLayout from "../layouts/DarkLayout.astro";
---

<DarkLayout isHome={true}>
	<section class="hero">
		<div class="profile-image">
			<img src="/images/headshot_oct_24.jpg" alt="Shah Jacob" />
		</div>
		<div class="name-section">
			<h1>Shah Jacob</h1>
		</div>
		<div class="content">
			<p class="intro">
				Hi! I'm a Sales Development Representative at <a href="https://www.getdbt.com/" class="keyword">dbt Labs</a>, helping data teams transform their analytics workflows. I joined in June 2025 after graduating with my BA in Computer Science from Queens College in May 2025.
			</p>

			<p class="experience">
				I most recently interned at <a href="https://www.pharmesol.com/">Pharmesol AI</a>, 
				helping out build out their backend APIs using <a href="https://fastapi.tiangolo.com/">FastAPI</a> 
				and integrating LLM Voice Agents using <a href="https://retell.ai">Retell AI</a>. 
				I also was responsible for creating dashboards in React using <a href="https://tremor.so/">TremorJS</a>.
			</p>

			<p class="interests">
				I'm pursuing sales roles across <a class="keyword">data engineering</a>, <a class="keyword">developer tooling</a>, and <a class="keyword">large language models</a> where I can leverage my engineering background to solve customer problems.
			</p>

			<div class="section-header">
				<h2>What I've built:</h2>
			</div>

			<div class="project-card">
				<h2>YFinance Market Data Observability Platform</h2>
				<p class="description">
					A real-time observability platform that monitors and analyzes requests to the YFinance API - built with FastAPI and Prometheus, and deployed with Docker compose for ease of deployment and scalability.
				</p>
				
				<div class="metrics-example">
					<p class="metrics-caption">Requests per symbol</p>
					<img src="/images/outputs_and_work/ticker_requests_counter_prom.png" alt="Symbol requests visualization" class="metrics-image" />
					<p class="metrics-description">
						This query shows how many times each stock symbol (AAPL, GOOGL, MSFT) was requested, tracking the frequency of symbol lookups in our test requests.
					</p>
				</div>

				<div class="tech-stack">
					<span>Prometheus</span>
					<span>Grafana</span>
					<span>Docker</span>
					<span>FastAPI</span>
				</div>

				<div class="links">
					<a href="https://github.com/shahjacobb/Market-Data-API-Observability-Platform" class="project-link">
						View Project →
					</a>
				</div>
			</div>

			<div class="section-header">
				<h2>Technical Skills</h2>
			</div>

			<div class="project-card">
				<div class="skills-grid">
					<div class="skill-category">
						<h3>Languages</h3>
						<p>Python, JavaScript, C++, Java</p>
					</div>
					<div class="skill-category">
						<h3>Frameworks/Services</h3>
						<p>
							React, NextJS, FastAPI, Flask, AWS Amplify, OpenAI
							API
						</p>
					</div>
					<div class="skill-category">
						<h3>Databases</h3>
						<p>AWS DynamoDB, MySQL</p>
					</div>
					<div class="skill-category">
						<h3>Tools & Platforms</h3>
						<p>
							Docker and Docker Compose, AWS S3, Prometheus,
							OpenTelemetry, Grafana
						</p>
					</div>
				</div>
			</div>
		</div>
	</section>
</DarkLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 2rem 0;
	}

	.profile-image {
		width: 200px;
		height: 200px;
		margin-bottom: 2rem;
	}

	.profile-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}

	.name-section {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	h1 {
		font-size: 3rem;
		margin: 0;
	}

	.content {
		max-width: 800px;
		margin: 0 auto;
	}

	.intro, .experience, .interests {
		font-size: 1.2rem;
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.content a {
		color: #f7c66f;
		text-decoration: none;
	}

	.content a:hover {
		text-decoration: underline;
	}

	.skills-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.skill-category h3 {
		color: #f7c66f;
		margin-bottom: 0.5rem;
	}

	.current-work h2 {
		font-size: 2rem;
		color: #ffffff;
	}

	.project-card {
		background: #1a1a1a;
		padding: 2rem;
		border-radius: 8px;
		margin: 2rem 0;
	}

	.project-card h2 {
		font-size: 1.8rem;
		color: #ffffff;
		margin-bottom: 1rem;
		font-weight: 500;
	}

	.description {
		font-size: 1.15rem;
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.metrics-example {
		background: #0a0a0a;
		padding: 1.5rem;
		border-radius: 6px;
		margin: 2rem 0;
	}

	.metrics-caption, .code-reference {
		color: #fff;
		font-size: 0.95rem;
		font-weight: 200;
		font-family: "Geist", sans-serif;
		letter-spacing: 0.2px;
		opacity: 0.8;
	}

	.metrics-caption {
		margin-bottom: 1rem;
	}

	.metrics-image {
		width: 100%;
		border-radius: 4px;
		border: 1px solid rgba(247, 198, 111, 0.2);
	}

	.metrics-description {
		color: #fff;
		font-size: 0.95rem;
		font-weight: 200;
		font-family: "Geist", sans-serif;
		letter-spacing: 0.2px;
		opacity: 0.8;
		margin-top: 1rem;
		line-height: 1.5;
	}

	.project-link {
		display: inline-block;
		padding: 1rem 2rem;
		background-color: #1a1a1a;
		color: #fff;
		border: 2px solid #f7c66f;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 500;
		font-size: 1.2rem;
		box-shadow: 0 4px 15px rgba(247, 198, 111, 0.3);
	}

	.tech-stack {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin: 1.5rem 0;
	}

	.tech-stack span {
		background: rgba(247, 198, 111, 0.1);
		color: #f7c66f;
		padding: 0.5em 1em;
		border-radius: 4px;
		font-size: 0.9rem;
	}

	.view-project-button {
		display: inline-block;
		padding: 0.8rem 1.5rem;
		color: #fff;
		text-decoration: none;
		font-size: 1.1rem;
		transition: color 0.2s;
	}

	.view-project-button:hover {
		color: #f7c66f;
	}

	@media (max-width: 768px) {
		.profile-image {
			width: 150px;
			height: 150px;
		}

		h1 {
			font-size: 2rem;
		}

		.intro, .experience, .interests {
			font-size: 1.1rem;
		}
	}

	.highlight {
		color: #f7c66f;
	}

	.content .interests .highlight {
		color: #f7c66f;
		font-weight: 500;
	}

	.keyword {
		color: #f7c66f !important;
		text-decoration: none !important;
		cursor: text;
	}
	
	.keyword:hover {
		text-decoration: none !important;
	}

	.section-header {
		background-color: rgba(26, 26, 26, 0.8);
		border-radius: 8px;
		padding: 1.5rem 2rem;
		margin: 4rem 0 2rem;
		width: 100%;
	}
	
	.section-header h2 {
		color: #f7c66f;
		font-size: 2.2rem;
		margin: 0;
		text-align: left;
		font-weight: 600;
	}
</style>
